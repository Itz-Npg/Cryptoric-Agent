{
  "name": "cryptoric-agent",
  "version": "0.1.3",
  "private": true,
  "description": "Cryptoric Agent — an AI-native desktop development environment operated by Cryptoric Chan.",
  "author": {
    "name": "Itz-Npg",
    "email": "152873138+Itz-Npg@users.noreply.github.com"
  },
  "license": "MIT",
  "main": "./out/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "build:dir": "electron-vite build",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:acceptance": "vitest run tests/acceptance",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "test:browser": "node scripts/build-live-check.mjs tests/live/browser-check.ts .review/live/browser-check.mjs && electron .review/live/browser-check.mjs",
    "test:model": "node scripts/build-live-check.mjs tests/live/model-check.ts .review/live/model-check.mjs && node .review/live/model-check.mjs",
    "test:agent": "node scripts/build-live-check.mjs tests/live/agent-check.ts .review/live/agent-check.mjs && node .review/live/agent-check.mjs",
    "test:migration": "node scripts/build-live-check.mjs tests/live/migration-check.ts .review/live/migration-check.mjs && node .review/live/migration-check.mjs",
    "test:command": "node scripts/build-live-check.mjs tests/live/command-check.ts .review/live/command-check.mjs && node .review/live/command-check.mjs",
    "test:apinex": "node scripts/build-live-check.mjs tests/live/apinex-check.ts .review/live/apinex-check.mjs && node .review/live/apinex-check.mjs",
    "test:agent:apinex": "node scripts/build-live-check.mjs tests/live/agent-check.ts .review/live/agent-check.mjs && node .review/live/agent-check.mjs apinex",
    "test:agent:laguna": "node scripts/build-live-check.mjs tests/live/agent-check.ts .review/live/agent-check.mjs && node .review/live/agent-check.mjs laguna",
    "test:agent:ling": "node scripts/build-live-check.mjs tests/live/agent-check.ts .review/live/agent-check.mjs && node .review/live/agent-check.mjs ling",
    "test:agent:laguna-xs": "node scripts/build-live-check.mjs tests/live/agent-check.ts .review/live/agent-check.mjs && node .review/live/agent-check.mjs laguna-xs"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.1.0",
    "@fontsource-variable/jetbrains-mono": "^5.1.1",
    "electron-updater": "^6.3.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^9.15.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
